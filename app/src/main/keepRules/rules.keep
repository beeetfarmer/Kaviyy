# MASVS R1: strip all logging from release builds.
-assumenosideeffects class com.nl.kaviyy.core.model.log.Log {
    public void d(...);
    public void i(...);
    public void w(...);
    public void e(...);
}
-assumenosideeffects class android.util.Log {
    public static int v(...);
    public static int d(...);
    public static int i(...);
    public static int w(...);
    public static int e(...);
    public static int println(...);
}
